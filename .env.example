# PostgreSQL connection string
# For Vercel deployment: add this in Vercel dashboard > Settings > Environment Variables
# For local dev: use a local PostgreSQL instance
DATABASE_URL="postgresql://postgres:password@localhost:5432/linktracker?schema=public"

# Session secret (generate a strong random string)
SESSION_SECRET="generate-a-random-string-at-least-32-characters-long"

# Base URL of your deployment
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
